generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  IDEA
  RESEARCH
  DRAFT
  AI_GENERATED
  HUMAN_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
  PUBLISHED
  UPDATED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentLanguage {
  en
  pt
  fr
}

model Site {
  id             String   @id @default(cuid())
  name           String
  baseUrl        String   @unique
  wpUsername     String
  wpAppPassword  String
  rankMathActive Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories Category[]
  pages      SitePage[]
  contents   ContentItem[]
  knowledge  BusinessFact[]
  jobs       Job[]
  clusters   TopicCluster[]
  topics     TopicIdea[]
  pageLinks  PageLink[]
}

model Category {
  id           String   @id @default(cuid())
  siteId       String
  wpCategoryId Int?
  name         String
  slug         String
  parentId     String?
  createdAt    DateTime @default(now())

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  contents ContentItem[]

  @@unique([siteId, slug])
}

model SitePage {
  id            String    @id @default(cuid())
  siteId        String
  wpPostId      Int?
  title         String
  url           String
  summary       String?
  pageType      String    @default("page")
  isOrphan      Boolean   @default(true)
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url])
}

model BusinessFact {
  id        String   @id @default(cuid())
  siteId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
}

model ContentItem {
  id              String          @id @default(cuid())
  siteId          String
  categoryId      String?
  language        ContentLanguage @default(en)
  status          ContentStatus   @default(IDEA)
  title           String
  slug            String?
  bodyHtml        String?
  focusKeyword    String?
  seoTitle        String?
  metaDescription String?
  schemaJson      Json?
  wpPostId        Int?
  wpUrl           String?
  rankMathVerified Boolean?
  reviewNote      String?
  rankMathMismatches String[]
  parentContentId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  parent   ContentItem?  @relation("Translations", fields: [parentContentId], references: [id])
  children ContentItem[] @relation("Translations")
  usages   AiUsage[]
  jobs     Job[]
  versions ContentVersion[]

  @@index([siteId, status])
}

model Job {
  id        String    @id @default(cuid())
  siteId    String?
  contentId String?
  type      String
  status    JobStatus @default(QUEUED)
  pct       Int       @default(0)
  label     String?
  error     String?
  payload   Json?
  result    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  site    Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  content ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([status])
}

enum TopicStatus {
  PROPOSED
  APPROVED
  REJECTED
}

model TopicCluster {
  id         String   @id @default(cuid())
  siteId     String
  name       String
  instruction String
  createdAt  DateTime @default(now())

  site   Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topics TopicIdea[]
}

model TopicIdea {
  id              String      @id @default(cuid())
  clusterId       String
  siteId          String
  title           String
  primaryKeyword  String
  secondaryKeywords String[]
  searchIntent    String?
  status          TopicStatus @default(PROPOSED)
  isUpdateToPage  Boolean     @default(false)
  relatedPageId   String?
  cannibalizes    String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  cluster TopicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  site    Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
}

model PageLink {
  id         String   @id @default(cuid())
  siteId     String
  sourceType String // "content" | "page"
  sourceId   String
  targetUrl  String
  targetTitle String?
  anchorText String?
  score      Float?
  createdAt  DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, sourceId])
}

model ContentVersion {
  id              String   @id @default(cuid())
  contentId       String
  title           String
  bodyHtml        String?
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime @default(now())

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model AiUsage {
  id           String   @id @default(cuid())
  contentId    String?
  provider     String
  model        String
  operation    String
  inputTokens  Int?
  outputTokens Int?
  estimatedUsd Float?
  createdAt    DateTime @default(now())

  content ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)
}
