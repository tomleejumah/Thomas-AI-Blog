# App
NODE_ENV=development
API_PORT=4000
# Comma-separated admin origins; https://*.vercel.app is also allowed in code
ADMIN_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ace:ace@localhost:5432/ace?schema=public
REDIS_URL=redis://localhost:6379

# Admin (Vercel / local). Production prefer https://api.tommlyjumah.dev/ai-content
# Fallback until nginx: http://100.84.133.5:4010
NEXT_PUBLIC_API_URL=http://localhost:4000

# Plug in when client sends keys (server-side only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# PERPLEXITY_API_KEY=

# Optional defaults for local WP PoC
# WORDPRESS_URL=https://example.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=
